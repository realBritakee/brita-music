{
  "name": "brita-music",
  "productName": "Brita Music",
  "private": true,
  "version": "0.2.1",
  "description": "A desktop player for your own music files. Folders are playlists.",
  "author": "Britakee Studios",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "test": "node --test tests/*.test.ts",
    "test:app": "npm run build && electron tests/app-check.cjs && electron tests/app-check.cjs --again",
    "test:updates": "npm run build && electron tests/update-check.cjs newer && electron tests/update-check.cjs same && electron tests/update-check.cjs offline",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "music-metadata": "^12.3.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "zustand": "^5.0.16"
  },
  "build": {
    "appId": "com.britakee.music",
    "productName": "Brita Music",
    "copyright": "Copyright © Britakee Studios",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "en-US",
      "de"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "realBritakee",
        "repo": "brita-music"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "Brita-Music-Setup-${version}.${ext}",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
